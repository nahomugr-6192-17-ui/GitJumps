<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="gameover-root" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(12, 12, 12, 0.45);">
        <ui:VisualElement name="gameover-card" style="width: 250px; align-items: center; justify-content: center; padding-top: 14px; padding-bottom: 14px; padding-left: 18px; padding-right: 18px; background-color: rgba(28, 28, 28, 0.94); border-width: 2px; border-color: rgb(75, 75, 75); border-radius: 12px;">
            <!-- Score Box -->
            <ui:Label text="SCORE" name="ScoreLabelText" style="color: rgba(255, 255, 255, 0.7); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center;" />
            <ui:Label text="0" name="CurrentScoreGameOver" style="color: rgb(255, 255, 255); font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; margin-top: 2px; margin-bottom: 2px;" />
            <ui:Label text="Best: 0" name="BestScore" style="color: rgba(180, 180, 180, 0.9); font-size: 14px; -unity-text-align: middle-center; margin-bottom: 12px;" />

            <!-- Buttons -->
            <ui:Button text="RESTART" name="RestartButton" style="width: 200px; height: 38px; font-size: 17px; border-radius: 8px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); margin-bottom: 7px; -unity-text-align: middle-center;" />
            <ui:Button text="HOME" name="HomeButton" style="width: 200px; height: 34px; font-size: 15px; border-radius: 8px; border-color: rgb(150, 150, 150); border-width: 1px; background-color: rgb(45, 45, 45); color: rgb(255, 255, 255); margin-bottom: 7px; -unity-text-align: middle-center;" />
            <ui:Button text="LEADERBOARD" name="LeaderboardButton" style="width: 200px; height: 34px; font-size: 14px; border-radius: 8px; border-color: rgb(150, 150, 150); border-width: 1px; background-color: rgb(45, 45, 45); color: rgb(255, 255, 255); -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
