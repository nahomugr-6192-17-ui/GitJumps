<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="home-root" style="width: 100%; height: 100%; justify-content: center; align-items: center; position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:Label text="GitJumps" name="WelcomingText" style="color: rgb(255, 255, 255); font-size: 54px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 18px;" />
        <ui:VisualElement name="home-button-column" style="width: 220px; align-items: stretch;">
            <ui:Button text="PLAY" name="PlayButton" style="height: 46px; font-size: 22px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); margin-bottom: 10px; -unity-text-align: middle-center;" />
            <ui:Button text="HOW TO PLAY?" name="HowToButton" style="height: 46px; font-size: 19px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); margin-bottom: 10px; -unity-text-align: middle-center;" />
            <ui:Button text="LEADERBOARD" name="LeaderboardButton" style="height: 46px; font-size: 19px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); margin-bottom: 10px; -unity-text-align: middle-center;" />
            <ui:Button text="QUIT" name="QuitButton" style="height: 46px; font-size: 22px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
