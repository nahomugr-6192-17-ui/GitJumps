<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="home-root" style="width: 100%; height: 100%; justify-content: center; align-items: center; position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:Label text="GitJumps" name="WelcomingText" style="color: rgb(255, 255, 255); font-size: 84px; -unity-font-style: normal; -unity-text-align: middle-center; margin-bottom: 24px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
        <ui:VisualElement name="home-button-column" style="width: 250px; align-items: stretch;">
            <ui:Button text="PLAY" name="PlayButton" style="height: 52px; font-size: 26px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); margin-bottom: 12px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=ead757a2fc4d3d24fbde2e097d5b476d&amp;type=3#MonaSans-VariableFont_wdth,wght&quot;);"/>
            <ui:Button text="HOW TO PLAY?" name="HowToButton" style="height: 52px; font-size: 22px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); margin-bottom: 12px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=ead757a2fc4d3d24fbde2e097d5b476d&amp;type=3#MonaSans-VariableFont_wdth,wght&quot;);"/>
            <ui:Button text="LEADERBOARD" name="LeaderboardButton" style="height: 52px; font-size: 22px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); margin-bottom: 12px; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=ead757a2fc4d3d24fbde2e097d5b476d&amp;type=3#MonaSans-VariableFont_wdth,wght&quot;);"/>
            <ui:Button text="QUIT" name="QuitButton" style="height: 52px; font-size: 26px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=ead757a2fc4d3d24fbde2e097d5b476d&amp;type=3#MonaSans-VariableFont_wdth,wght&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
