    <ui:Button text="HOW TO PLAY?" name="HowToButton" style="width: 249px; height: 52px; justify-content: flex-start; align-items: flex-start; align-content: center; align-self: center; top: 190px; font-size: 26px; border-bottom-right-radius: 12px; border-top-right-radius: 12px; border-top-left-radius: 12px; border-bottom-left-radius: 12px; border-left-color: rgb(196, 196, 196); border-right-color: rgb(196, 196, 196); border-top-color: rgb(196, 196, 196); border-bottom-color: rgb(196, 196, 196); background-color: rgb(55, 55, 55); color: rgb(255, 255, 255);"/>
    <ui:Button text="LEADERBOARD" name="LeaderboardButton" style="width: 249px; height: 52px; justify-content: flex-start; align-items: flex-start; align-content: center; align-self: center; top: 210px; font-size: 26px; border-bottom-right-radius: 12px; border-top-right-radius: 12px; border-top-left-radius: 12px; border-bottom-left-radius: 12px; border-left-color: rgb(196, 196, 196); border-right-color: rgb(196, 196, 196); border-top-color: rgb(196, 196, 196); border-bottom-color: rgb(196, 196, 196); background-color: rgb(55, 55, 55); color: rgb(255, 255, 255);"/>
    <ui:Button text="QUIT" name="QuitButton" style="width: 249px; height: 52px; justify-content: flex-start; align-items: flex-start; align-content: center; align-self: center; top: 230px; font-size: 30px; border-bottom-right-radius: 12px; border-top-right-radius: 12px; border-top-left-radius: 12px; border-bottom-left-radius: 12px; border-left-color: rgb(196, 196, 196); border-right-color: rgb(196, 196, 196); border-top-color: rgb(196, 196, 196); border-bottom-color: rgb(196, 196, 196); background-color: rgb(55, 55, 55); color: rgb(255, 255, 255);"/>
