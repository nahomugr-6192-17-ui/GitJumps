<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="htp-root" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="htp-content-container" style="position: absolute; right: 5%; top: 0; bottom: 0; width: 440px; justify-content: center; align-items: flex-start;">
            <ui:Label text="W / JUMP   - Hold to Jump" name="JumpButton" style="color: rgb(255, 255, 255); font-size: 20px; margin-bottom: 12px; -unity-font-style: bold;" />
            <ui:Label text="A / LEFT   - Hold to Move Left" name="LeftButton" style="color: rgb(255, 255, 255); font-size: 20px; margin-bottom: 12px; -unity-font-style: bold;" />
            <ui:Label text="D / RIGHT  - Hold to Move Right" name="RightButton" style="color: rgb(255, 255, 255); font-size: 20px; margin-bottom: 18px; -unity-font-style: bold;" />
            <ui:Button text="START PLAYING" name="PlayButtonInHTP" style="width: 220px; height: 46px; font-size: 19px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
