<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="htp-root" style="width: 100%; height: 100%; position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:VisualElement name="htp-content-container" style="position: absolute; right: 6%; top: 0; bottom: 0; width: 500px; justify-content: center; align-items: flex-start;">
            <ui:Label text="W / ▲   - Hold to Jump" name="JumpButton" style="color: rgb(255, 255, 255); font-size: 34px; margin-bottom: 16px; -unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
            <ui:Label text="A / ◄   - Hold to Move Left" name="LeftButton" style="color: rgb(255, 255, 255); font-size: 34px; margin-bottom: 16px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
            <ui:Label text="D / ►   - Hold to Move Right" name="RightButton" style="color: rgb(255, 255, 255); font-size: 34px; margin-bottom: 28px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
            <ui:Button text="START PLAYING" name="PlayButtonInHTP" style="width: 250px; height: 52px; font-size: 24px; border-radius: 12px; border-color: rgb(196, 196, 196); border-width: 1px; background-color: rgb(55, 55, 55); color: rgb(255, 255, 255); -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
