<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/LeaderboardUI.uss?fileID=7433441132597879392&amp;guid=a1b8541d740e04656c3edbcce5a5f964&amp;type=3#LeaderboardUI"/>
    <ui:VisualElement name="LeaderboardOverlay" class="leaderboard-overlay" style="display: none;">
        <ui:VisualElement name="LeaderboardModal" class="leaderboard-modal">
            <ui:VisualElement class="leaderboard-header-row">
                <ui:Label text="GLOBAL LEADERBOARD" class="leaderboard-title" style="-unity-font-style: normal; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
                <ui:Button text="X" name="LeaderboardCloseButton" class="close-button"/>
            </ui:VisualElement>
            <ui:VisualElement name="ProfileArea" class="profile-card">
                <ui:VisualElement class="profile-player-info">
                    <ui:Label text="Player Name" name="ProfileDisplayName" class="profile-name" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
                    <ui:Label text="GJ-0000" name="ProfilePlayerCode" class="profile-code" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
                </ui:VisualElement>
                <ui:VisualElement class="profile-stats">
                    <ui:VisualElement class="profile-stat-item">
                        <ui:Label text="BEST SCORE" class="profile-stat-label" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
                        <ui:Label text="0" name="ProfileBestScore" class="profile-stat-value" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="profile-stat-item">
                        <ui:Label text="GLOBAL RANK" class="profile-stat-label"/>
                        <ui:Label text="-" name="ProfileGlobalRank" class="profile-stat-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="table-container">
                <ui:VisualElement class="table-header">
                    <ui:Label text="Display name" class="table-header-col col-name"/>
                    <ui:Label text="Best score" class="table-header-col col-score"/>
                    <ui:Label text="Leaderboard" class="table-header-col col-rank"/>
                </ui:VisualElement>
                <ui:ScrollView name="LeaderboardScrollView" class="table-scroll"/>
                <ui:VisualElement name="LoadingState" class="status-container" style="display: none;">
                    <ui:Label text="Loading leaderboard..." class="status-text"/>
                </ui:VisualElement>
                <ui:VisualElement name="ErrorState" class="status-container" style="display: none;">
                    <ui:Label text="Failed to load leaderboard." name="ErrorMessageLabel" class="status-text status-error-text"/>
                </ui:VisualElement>
                <ui:VisualElement name="EmptyState" class="status-container" style="display: none;">
                    <ui:Label text="No scores recorded yet." class="status-text"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="leaderboard-footer">
                <ui:Button text="REFRESH" name="LeaderboardRefreshButton" class="refresh-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
