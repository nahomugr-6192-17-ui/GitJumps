<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="gameplay-ui-root" picking-mode="Ignore" style="flex-grow: 1; width: 100%; height: 100%; position: absolute; left: 0; top: 0; right: 0; bottom: 0;">
        <ui:Label text="Score: 0" name="currentScoreLabel" picking-mode="Ignore" style="color: rgb(255, 255, 255); font-size: 32px; visibility: visible; width: 220px; flex-direction: column; position: absolute; top: 20px; left: 24px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=ead757a2fc4d3d24fbde2e097d5b476d&amp;type=3#MonaSans-VariableFont_wdth,wght&quot;);"/>
        <ui:VisualElement name="mobile-controls-root" picking-mode="Ignore" style="position: absolute; left: 0; right: 0; bottom: 0; top: 0; width: 100%; height: 100%; display: none;">
            <ui:VisualElement name="left-touch-container" picking-mode="Ignore" style="position: absolute; bottom: 24px; left: 28px; flex-direction: row; align-items: center;">
                <ui:Button name="btn-move-left" text="◄" class="touch-ctrl-btn" style="width: 126px; height: 126px; margin-right: 16px; background-color: rgba(18, 22, 32, 0.82); border-color: rgba(100, 116, 139, 0.85); border-width: 2px; border-radius: 0; color: rgb(255, 255, 255); font-size: 52px; -unity-font-style: bold; align-items: center; justify-content: center; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
                <ui:Button name="btn-move-right" text="►" class="touch-ctrl-btn" style="width: 126px; height: 126px; background-color: rgba(18, 22, 32, 0.82); border-color: rgba(100, 116, 139, 0.85); border-width: 2px; border-radius: 0; color: rgb(255, 255, 255); font-size: 52px; -unity-font-style: bold; align-items: center; justify-content: center; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
            </ui:VisualElement>
            <ui:VisualElement name="right-touch-container" picking-mode="Ignore" style="position: absolute; bottom: 24px; right: 28px; flex-direction: row; align-items: center;">
                <ui:Button name="btn-jump" text="▲" class="touch-ctrl-btn" style="width: 160px; height: 126px; background-color: rgba(18, 22, 32, 0.88); border-color: rgba(100, 116, 139, 0.9); border-width: 2px; border-radius: 0; color: rgb(255, 255, 255); font-size: 52px; -unity-font-style: bold; align-items: center; justify-content: center; -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/MonaSans_SemiExpanded-Medium.ttf?fileID=12800000&amp;guid=719e9db23dd4a534bbee8afd8e7c6b81&amp;type=3#MonaSans_SemiExpanded-Medium&quot;);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
